// Copy to include/secrets.h and fill in. secrets.h is git-ignored: never commit it.
// There is NO Stripe key here: the board only holds its own device token, which you can change at any time.
#pragma once

#define WIFI_SSID     "your-wifi-name"          // 2.4 GHz network (the ESP32 has no 5 GHz)
#define WIFI_PASS     "your-wifi-password"

#define WS_HOST       "qrun-lite.<your-subdomain>.workers.dev"   // your Worker's host, no https://
#define WS_PORT       443
#define WS_USE_TLS    1                          // 0 only for a local `wrangler dev` (token sent in cleartext)

#define DEVICE_ID     "kiosk-01"                 // any name, shown in the Worker logs
#define DEVICE_TOKEN  "paste-the-same-value-as-the-DEVICE_TOKEN-secret"
